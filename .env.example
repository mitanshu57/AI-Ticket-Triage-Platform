# ---- Postgres ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=triage
POSTGRES_PORT=5432

# ---- Application ----
# Async driver URL used by the app and Alembic.
# Host is "db" inside Docker Compose; use "localhost" for local dev.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/triage

APP_ENV=local
LOG_LEVEL=INFO
API_PORT=8000

# CORS origins (comma-separated). The Phase 9 Next.js frontend runs on :3000.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ---- Reserved for later phases (not used in Phase 1) ----
# ANTHROPIC_API_KEY=
# REDIS_URL=redis://redis:6379/0
