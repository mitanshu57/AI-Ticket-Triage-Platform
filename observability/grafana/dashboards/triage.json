{
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "title": "AI Ticket Triage",
  "tags": ["triage"],
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Tickets created (rate/min)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(triage_tickets_created_total[5m]) * 60",
          "legendFormat": "created/min"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Triage completions by category (rate/min)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (category) (rate(triage_completed_total[5m])) * 60",
          "legendFormat": "{{category}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Triage duration (p50 / p95)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(triage_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(triage_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Drafts flagged needs_review (rate/min)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (needs_review) (rate(triage_completed_total[5m])) * 60",
          "legendFormat": "needs_review={{needs_review}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP request rate by handler",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (handler) (rate(http_requests_total[5m]))",
          "legendFormat": "{{handler}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Triage jobs enqueued (rate/min)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "rate(triage_jobs_enqueued_total[5m]) * 60",
          "legendFormat": "enqueued/min"
        }
      ]
    }
  ]
}
